<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="MotoPlanner" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>佐賀・呼子 温泉＆イカ活き造り満喫ツーリング（1泊2日）</name>
    <desc>福岡空港発着。三瀬峠のワインディングと嬉野温泉・大正屋での宿泊、2日目は呼子のイカ活き造りと海沿い絶景を楽しむ1泊2日ツーリング</desc>
    <time>2026-11-13T12:00:00Z</time>
  </metadata>

  <!-- 主要ウェイポイント（立ち寄り・経由地） -->
  <wpt lat="33.5859" lon="130.4509">
    <name>① 発着地：福岡空港周辺（レンタルバイク店）</name>
    <desc>11/13 12:00出発 / 11/14 18:00返却リミット厳守</desc>
  </wpt>
  <wpt lat="33.4475" lon="130.2797">
    <name>② 休憩・昼食：三瀬峠・三瀬そば周辺</name>
    <desc>11/13 13:00到着。適度なワインディングと三瀬そば・小休止</desc>
  </wpt>
  <wpt lat="33.0970" lon="129.9880">
    <name>③ 宿泊先：嬉野観光ホテル大正屋</name>
    <desc>11/13 16:30到着。日本三大美肌の湯と宿の極上夕食を満喫</desc>
  </wpt>
  <wpt lat="33.5398" lon="129.8967">
    <name>④ 昼食：呼子港（イカ活き造り）</name>
    <desc>11/14 12:00到着。名物の透明なイカ活き造りを堪能</desc>
  </wpt>
  <wpt lat="33.3444" lon="130.0827">
    <name>⑤ 休憩：道の駅 厳木（きゅうらぎ）</name>
    <desc>11/14 14:30到着。夕方渋滞回避のため内陸ルートへ舵を切るポイント</desc>
  </wpt>
  <wpt lat="33.2840" lon="130.1260">
    <name>⑥ 高速ワープ：厳木多久道路・多久IC</name>
    <desc>11/14 15:30。夕方ラッシュを高速でパスして安全帰着</desc>
  </wpt>

  <!-- 走行トラック（1日目＆2日目の主要ルート） -->
  <trk>
    <name>佐賀・呼子周遊ルート</name>
    <trkseg>
