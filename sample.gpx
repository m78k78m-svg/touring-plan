<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="MotoPlanner" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>箱根・芦ノ湖絶景ツーリング</name>
    <desc>西湘バイパスからアネスト岩田ターンパイクを駆け上がり、大観山からの富士山と芦ノ湖スカイラインを満喫する王道ルート</desc>
    <time>2026-11-03T07:30:00Z</time>
  </metadata>

  <!-- 立ち寄りスポット・集合場所のウェイポイント -->
  <wpt lat="35.2891" lon="139.2235">
    <name>① 集合：西湘PA（下り）</name>
    <desc>7:30集合。朝の海風を感じながらミーティング＆給油確認</desc>
  </wpt>
  <wpt lat="35.2173" lon="139.0526">
    <name>② 休憩：アネスト岩田スカイラウンジ（大観山）</name>
    <desc>9:00到着。富士山と芦ノ湖の絶景ビューポイント。温かいコーヒー休憩</desc>
  </wpt>
  <wpt lat="35.2045" lon="138.9958">
    <name>③ 昼食：芦ノ湖畔・御番所茶屋</name>
    <desc>11:30到着。名物そばと芦ノ湖の景色を満喫</desc>
  </wpt>
  <wpt lat="35.2634" lon="138.9882">
    <name>④ 休憩：芦ノ湖スカイライン レストハウス</name>
    <desc>13:30到着。ワインディングを爽快に流した後のスイーツ休憩</desc>
  </wpt>
  <wpt lat="35.3188" lon="139.0125">
    <name>⑤ 解散：乙女峠 富士見茶屋</name>
    <desc>15:00解散。東名御殿場IC方面へスムーズに合流可能</desc>
  </wpt>

  <!-- 走行トラックログ（主要ポイントの座標列） -->
  <trk>
    <name>箱根ワインディング・ルート</name>
    <trkseg>
      <!-- 西湘PA〜小田原 -->
